# ==================== SparkLaw 前端环境变量配置 ====================
# 请复制此文件为 .env.local 并填入实际配置

# ==================== API 配置 ====================
# 浏览器侧 API 地址。默认留空，前端会请求同源 /api，再由 Next 代理到后端。
# 只有当前端和后端明确部署在不同公开域名时，才填类似 https://api.sparklaw.com。
NEXT_PUBLIC_API_URL=

# Next 服务端代理目标。Docker 内部默认使用 http://backend:8000；本地开发默认使用 http://localhost:8000。
BACKEND_INTERNAL_URL=http://localhost:8000

# ==================== 应用配置 ====================
# 应用名称
NEXT_PUBLIC_APP_NAME=SparkLaw

# 应用版本
NEXT_PUBLIC_APP_VERSION=2.0.0

# ==================== 功能开关 ====================
# 是否启用调试模式
NEXT_PUBLIC_DEBUG=true

# 是否启用分析统计
NEXT_PUBLIC_ENABLE_ANALYTICS=false
