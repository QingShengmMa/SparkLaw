# SparkLaw 环境变量配置
# 请复制此文件为 .env 并填入实际配置

# ==================== 应用基础配置 ====================
APP_NAME=SparkLaw
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ==================== LLM 配置 ====================
# LLM 模式选择：'local' 或 'cloud'
LLM_MODE=cloud

# 本地模式配置（使用 Ollama）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=2048

# 云端模式配置（服务端统一保管 Key）
# 调用顺序默认：Groq -> DeepSeek。Groq 限流/额度耗尽时自动回退 DeepSeek。
LLM_PROVIDER_ORDER=groq,deepseek
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_INPUT_COST_PER_1M=0.05
GROQ_OUTPUT_COST_PER_1M=0.08
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_INPUT_COST_PER_1M=0.27
DEEPSEEK_OUTPUT_COST_PER_1M=1.10

# 兼容旧 OpenAI 配置：只有在 Groq/DeepSeek 都未配置时才回退使用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2048

# ==================== Agent 配置 ====================
AGENT_MAX_ITERATIONS=5
AGENT_VERBOSE=true

# ==================== 工具配置 ====================
ENABLE_WEB_SEARCH=true
ENABLE_CALCULATOR=false

# ==================== 法律辖区配置 ====================
DEFAULT_JURISDICTION=中国

# ==================== API 配置 ====================
API_PREFIX=/api

# CORS 跨域配置（开发环境）
# 生产环境请修改为实际的前端域名
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==================== 账号认证配置 ====================
AUTH_ENABLED=true
AUTH_ALLOW_REGISTRATION=true
# 填写后注册页需要邀请码；留空则开放普通注册
AUTH_REGISTRATION_INVITE_CODE=
AUTH_DB_PATH=data/sparklaw.sqlite3
AUTH_COOKIE_NAME=sparklaw_session
# 生产 HTTPS 环境建议改为 true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_DAYS=14
AUTH_PASSWORD_MIN_LENGTH=10

# ==================== 日志配置 ====================
LOG_FILE=logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# ==================== 向量数据库配置（Qdrant）====================
# Qdrant 服务地址
QDRANT_URL=http://localhost:6333
# Qdrant API Key（可选，用于云端部署）
QDRANT_API_KEY=
# Collection 名称
QDRANT_COLLECTION_CONTRACTS=legal_contracts
QDRANT_COLLECTION_LAWS=legal_corpus
# 向量维度（BAAI/bge-small-zh-v1.5 的维度为 512）
QDRANT_VECTOR_SIZE=512

# 兼容旧配置（用于数据迁移）
CHROMA_PERSIST_DIR=./data/chroma_db

# 语义记忆/向量模型开关（联调建议）
# - 外网不稳定时可先关闭语义记忆，避免模型下载超时阻塞启动
# - 本地已缓存模型可设为 true 仅本地加载
ENABLE_SEMANTIC_MEMORY=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_ONLY=false

# ==================== 语义缓存配置 ====================
# 启用语义缓存可大幅降低高频相似查询的响应时间
ENABLE_SEMANTIC_CACHE=true
# 相似度阈值（0-1），超过此值判定为缓存命中
SEMANTIC_CACHE_THRESHOLD=0.92
# 缓存检索返回的最相似条目数
SEMANTIC_CACHE_TOP_K=1
# 缓存过期时间（天）
SEMANTIC_CACHE_TTL_DAYS=30

# ==================== Redis / Celery 配置 ====================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
